    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Reactivation_Record_Type</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.Refusal_Reason__c}), NOT(ISBLANK(TEXT({!$Record.Refusal_Reason__c}))), OR({!$Record.RecordType.DeveloperName} = &quot;New_Clients&quot;, {!$Record.RecordType.DeveloperName} = &quot;Repeat_Sales&quot;), NOT(ISPICKVAL({!$Record.StageName}, &quot;Closed Won&quot;)), NOT(ISPICKVAL({!$Record.StageName}, &quot;Closed Lost&quot;)))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
